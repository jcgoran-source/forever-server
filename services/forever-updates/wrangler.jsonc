{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "forever-updates",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-21",
  "workers_dev": false,
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": ["* * * * *"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "UPDATE_STATE",
        "class_name": "UpdateState"
      },
      {
        "name": "BRIEFING_STATE",
        "class_name": "BriefingState"
      }
    ]
  },
  "exports": {
    "UpdateState": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "BriefingState": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
